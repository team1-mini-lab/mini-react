{
  "name": "mini-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:docs": "python3 scripts/check_docs.py",
    "check:stack": "python3 scripts/check_stack.py",
    "check:vt": "python3 scripts/check_vt_tests.py",
    "check:trace": "python3 scripts/check_trace.py",
    "test:harness": "python3 scripts/selftest_harness.py",
    "report": "python3 scripts/report.py",
    "verify:docs": "npm run check:docs && npm run test:harness",
    "verify": "npm run typecheck && npm run check:stack && npm run check:arch && npm run lint && npm run check:docs && npm run test",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.0.0",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
